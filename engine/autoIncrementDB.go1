// AutoIncrementDB 实现uint8自动增值功能
type AutoIncrementDB struct {
	kvStore  storage.Store // 用于持久化存储
	key      []byte        // 存储计数器的键
	maxValue uint8         // uint8的最大值
	//mu       sync.Mutex    // 保护并发访问的互斥锁 。这应该是调用方负责的
}

// NewAutoIncrementDB 创建一个新的AutoIncrementDB实例
func NewAutoIncrementDB(kvStore storage.Store, key string) *AutoIncrementDB {
	return &AutoIncrementDB{
		kvStore:  kvStore,
		key:      []byte(key),
		maxValue: 255, // uint8最大值
	}
}

// GetNextID 获取下一个自动增值ID
// 支持并发调用，通过互斥锁保证原子性
func (adb *AutoIncrementDB) GetNextID() (uint8, error) {
	// 加锁，确保Get-Put操作的原子性
	//adb.mu.Lock()
	//defer adb.mu.Unlock()

	// 读取当前计数器值
	currentBytes, err := adb.kvStore.Get(adb.key)
	if err != nil {
		if err == storage.ErrNotFound {
			// 如果键不存在，初始化计数器为1（第一个ID）
			if err = adb.kvStore.Put(adb.key, []byte{1}); err != nil {
				return 0, fmt.Errorf("初始化计数器失败: %v", err)
			}
			return 1, nil // 第一个ID为1
		}
		return 0, fmt.Errorf("读取计数器失败: %v", err)
	}

	// 解析当前值
	if len(currentBytes) != 1 {
		return 0, fmt.Errorf("计数器值格式错误")
	}

	currentID := uint8(currentBytes[0])

	// 检查是否达到最大值
	if currentID >= adb.maxValue {
		return 0, fmt.Errorf("uint8自动增值已达到最大值255")
	}

	// 保存当前ID作为返回值
	nextID := currentID

	// 计算并更新计数器为下一个值
	newCounterValue := currentID + 1
	if err := adb.kvStore.Put(adb.key, []byte{byte(newCounterValue)}); err != nil {
		return 0, fmt.Errorf("更新计数器失败: %v", err)
	}

	return nextID, nil
}

// Reset 重置计数器，下一个ID将从1开始
func (adb *AutoIncrementDB) Reset() error {
	// 重置后，下一个ID为1
	return adb.kvStore.Put(adb.key, []byte{1})
}

// GetCurrentID 获取当前已使用的最大ID
func (adb *AutoIncrementDB) GetCurrentID() (uint8, error) {
	currentBytes, err := adb.kvStore.Get(adb.key)
	if err != nil {
		if err == storage.ErrNotFound {
			return 0, nil // 未初始化时返回0
		}
		return 0, fmt.Errorf("读取计数器失败: %v", err)
	}

	if len(currentBytes) != 1 {
		return 0, fmt.Errorf("计数器值格式错误")
	}

	nextID := uint8(currentBytes[0])
	// 返回已使用的最大ID，即下一个ID减1
	if nextID > 0 {
		return nextID - 1, nil
	}
	return 0, nil
}
