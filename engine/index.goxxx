package engine

import (
	"github.com/liaoran123/sfsDb/engine/types"
	"github.com/liaoran123/sfsDb/storage"
)

// PrimaryIndex 主键索引实现
type PrimaryIndex struct {
	name    string
	table   *TableImpl
	kvStore storage.Store
}

// SecondaryIndex 二级索引实现
type SecondaryIndex struct {
	name      string
	table     *TableImpl
	kvStore   storage.Store
	indexType types.IndexType
	fields    []string
}

// NewPrimaryIndex 创建主键索引
func NewPrimaryIndex(table *TableImpl) (Index, error) {
	return nil, nil
	/*
		return &PrimaryIndex{
			name:    "primary",
			table:   table,
			kvStore: table.kvStore,

		}, nil
	*/
}

// NewSecondaryIndex 创建二级索引
func NewSecondaryIndex(table *TableImpl, indexDef *types.IndexDef) (Index, error) {
	return nil, nil
	/*
		return &SecondaryIndex{
			name:      indexDef.Name,
			table:     table,
			kvStore:   table.kvStore,
			indexType: indexDef.Type,
			fields:    indexDef.Fields,
		}, nil
	*/
}

// GetName 获取索引名
func (idx *PrimaryIndex) GetName() string {
	return idx.name
}

// GetType 获取索引类型
func (idx *PrimaryIndex) GetType() types.IndexType {
	return types.IndexTypeBTree
}

// Add 添加索引项
func (idx *PrimaryIndex) Add(key []byte, value []byte) error {
	return idx.kvStore.Put(key, value)
}

// Delete 删除索引项
func (idx *PrimaryIndex) Delete(key []byte) error {
	return idx.kvStore.Delete(key)
}

// Get 查询索引项
func (idx *PrimaryIndex) Get(key []byte) ([]byte, error) {
	return idx.kvStore.Get(key)
}

// Iterator 创建索引迭代器
func (idx *PrimaryIndex) Iterator(prefix []byte) storage.Iterator {
	return idx.kvStore.Iterator(prefix)
}

// Close 关闭索引
func (idx *PrimaryIndex) Close() error {
	return nil
}

// GetName 获取索引名
func (idx *SecondaryIndex) GetName() string {
	return idx.name
}

// GetType 获取索引类型
func (idx *SecondaryIndex) GetType() types.IndexType {
	return idx.indexType
}

// Add 添加索引项
func (idx *SecondaryIndex) Add(key []byte, value []byte) error {
	return idx.kvStore.Put(key, value)
}

// Delete 删除索引项
func (idx *SecondaryIndex) Delete(key []byte) error {
	return idx.kvStore.Delete(key)
}

// Get 查询索引项
func (idx *SecondaryIndex) Get(key []byte) ([]byte, error) {
	return idx.kvStore.Get(key)
}

// Iterator 创建索引迭代器
func (idx *SecondaryIndex) Iterator(prefix []byte) storage.Iterator {
	return idx.kvStore.Iterator(prefix)
}

// Close 关闭索引
func (idx *SecondaryIndex) Close() error {
	return nil
}
