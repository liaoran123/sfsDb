package storage

import (
	"github.com/syndtr/goleveldb/leveldb/util"
)

// RangeHelper 提供LevelDB Range的辅助函数和常量
// 注意：在LevelDB中，util.Range的Start是包含的，Limit是不包含的
// 即区间为 [Start, Limit)
type RangeHelper struct{}

// NewRangeHelper 创建一个新的RangeHelper实例
func NewRangeHelper() *RangeHelper {
	return &RangeHelper{}
}

// 常用的Range变量
var (
	// FullScanRange 表示全库扫描的Range
	FullScanRange *util.Range
)

// FullScan 返回全库扫描的Range
// 当slice为nil时，迭代器会遍历整个数据库
func (h *RangeHelper) FullScan() *util.Range {
	return FullScanRange
}

// Prefix 返回前缀扫描的Range
// 例如：h.Prefix([]byte("user_")) 将匹配所有以"user_"为前缀的key
func (h *RangeHelper) Prefix(prefix []byte) *util.Range {
	return util.BytesPrefix(prefix)
}

// BytesPrefix 返回前缀扫描的Range（静态方法）
// 例如：BytesPrefix([]byte("user_")) 将匹配所有以"user_"为前缀的key
func BytesPrefix(prefix []byte) *util.Range {
	return util.BytesPrefix(prefix)
}

// KeyRange 创建一个闭区间 [start, end]
// start: 范围开始（包含）
// end: 范围结束（包含）
// 返回一个util.Range，确保包含end
func (h *RangeHelper) KeyRange(start, end []byte) *util.Range {
	return &util.Range{
		Start: start,
		Limit: append(end, 0), // end+1，确保包含end
	}
}

// KeyRange 创建一个闭区间 [start, end]（静态方法）
// start: 范围开始（包含）
// end: 范围结束（包含）
// 返回一个util.Range，确保包含end
func KeyRange(start, end []byte) *util.Range {
	return &util.Range{
		Start: start,
		Limit: append(end, 0), // end+1，确保包含end
	}
}

// ExclusiveRange 创建一个左开右开的键范围 (start, end)
// start: 范围开始（不包含）
// end: 范围结束（不包含）
func (h *RangeHelper) ExclusiveRange(start, end []byte) *util.Range {
	return &util.Range{
		Start: append(start, 0), // start+1，不包含start
		Limit: end,              // 不包含end
	}
}

// ExclusiveKeyRange 创建一个左开右开的键范围 (start, end)（静态方法）
// start: 范围开始（不包含）
// end: 范围结束（不包含）
func ExclusiveKeyRange(start, end []byte) *util.Range {
	return &util.Range{
		Start: append(start, 0), // start+1，不包含start
		Limit: end,              // 不包含end
	}
}

// OpenClosedRange 创建一个左开右闭的键范围 (start, end]
// start: 范围开始（不包含）
// end: 范围结束（包含）
func (h *RangeHelper) OpenClosedRange(start, end []byte) *util.Range {
	return &util.Range{
		Start: append(start, 0), // start+1，不包含start
		Limit: append(end, 0),   // end+1，包含end
	}
}

// OpenClosedKeyRange 创建一个左开右闭的键范围 (start, end]（静态方法）
// start: 范围开始（不包含）
// end: 范围结束（包含）
func OpenClosedKeyRange(start, end []byte) *util.Range {
	return &util.Range{
		Start: append(start, 0), // start+1，不包含start
		Limit: append(end, 0),   // end+1，包含end
	}
}

// ClosedOpenRange 创建一个左闭右开的键范围 [start, end)
// start: 范围开始（包含）
// end: 范围结束（不包含）
func (h *RangeHelper) ClosedOpenRange(start, end []byte) *util.Range {
	return &util.Range{
		Start: start,
		Limit: end,
	}
}

// ClosedOpenKeyRange 创建一个左闭右开的键范围 [start, end)（静态方法）
// start: 范围开始（包含）
// end: 范围结束（不包含）
func ClosedOpenKeyRange(start, end []byte) *util.Range {
	return &util.Range{
		Start: start,
		Limit: end,
	}
}

// SingleValue 创建一个单值扫描的Range [value, value+1)
// 只扫描key等于value的记录
func (h *RangeHelper) SingleValue(value []byte) *util.Range {
	return &util.Range{
		Start: value,
		Limit: append(value, 0), // value+1，只包含value
	}
}

// SingleValueRange 创建一个单值扫描的Range [value, value+1)（静态方法）
// 只扫描key等于value的记录
func SingleValueRange(value []byte) *util.Range {
	return &util.Range{
		Start: value,
		Limit: append(value, 0), // value+1，只包含value
	}
}

// FromStart 创建一个从某个key开始的所有记录的Range [start, +∞)
// start: 范围开始（包含）
// 返回的Range将匹配所有大于等于start的key
func (h *RangeHelper) FromStart(start []byte) *util.Range {
	return &util.Range{
		Start: start,
		Limit: nil, // 没有上限
	}
}

// FromStartRange 创建一个从某个key开始的所有记录的Range [start, +∞)（静态方法）
// start: 范围开始（包含）
// 返回的Range将匹配所有大于等于start的key
func FromStartRange(start []byte) *util.Range {
	return &util.Range{
		Start: start,
		Limit: nil, // 没有上限
	}
}

// ToEnd 创建一个到某个key结束的所有记录的Range (-∞, end)
// end: 范围结束（不包含）
// 返回的Range将匹配所有小于end的key
func (h *RangeHelper) ToEnd(end []byte) *util.Range {
	return &util.Range{
		Start: nil, // 没有下限
		Limit: end,
	}
}

// ToEndRange 创建一个到某个key结束的所有记录的Range (-∞, end)（静态方法）
// end: 范围结束（不包含）
// 返回的Range将匹配所有小于end的key
func ToEndRange(end []byte) *util.Range {
	return &util.Range{
		Start: nil, // 没有下限
		Limit: end,
	}
}

// NumericRange 创建一个数值范围的Range [start, end)
// 假设key是数值的字符串形式，如"100", "101", ..., "199"
// start: 数值范围开始（包含）
// end: 数值范围结束（不包含）
func (h *RangeHelper) NumericRange(start, end []byte) *util.Range {
	return &util.Range{
		Start: start,
		Limit: end,
	}
}

// NumericRange 创建一个数值范围的Range [start, end)（静态方法）
// 假设key是数值的字符串形式，如"100", "101", ..., "199"
// start: 数值范围开始（包含）
// end: 数值范围结束（不包含）
func NumericRange(start, end []byte) *util.Range {
	return &util.Range{
		Start: start,
		Limit: end,
	}
}

// EmptyRange 创建一个空范围的Range
// 当Start等于Limit时，范围为空，不会返回任何记录
func (h *RangeHelper) EmptyRange(value []byte) *util.Range {
	return &util.Range{
		Start: value,
		Limit: value,
	}
}

// EmptyRange 创建一个空范围的Range（静态方法）
// 当Start等于Limit时，范围为空，不会返回任何记录
func EmptyRange(value []byte) *util.Range {
	return &util.Range{
		Start: value,
		Limit: value,
	}
}
