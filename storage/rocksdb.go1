package storage

import (
	"github.com/linxGnu/grocksdb"
)

// RocksDBStore RocksDB存储实现，支持快照功能
type RocksDBStore struct {
	db         *grocksdb.DB
	snap       *grocksdb.Snapshot
	opts       *grocksdb.Options
	rOpts      *grocksdb.ReadOptions
	wOpts      *grocksdb.WriteOptions
	cfOpts     *grocksdb.ColumnFamilyOptions
	cfHandles  []*grocksdb.ColumnFamilyHandle
	isSnapshot bool
}

// RocksDBSnapshot RocksDB快照实现
type RocksDBSnapshot struct {
	store    *RocksDBStore
	snapshot *grocksdb.Snapshot
}

// RocksDBIterator RocksDB迭代器实现
type RocksDBIterator struct {
	iter *grocksdb.Iterator
}

// RocksDBBatch RocksDB批量操作实现
type RocksDBBatch struct {
	batch *grocksdb.WriteBatch
	db    *grocksdb.DB
	wOpts *grocksdb.WriteOptions
}

// NewRocksDBStore 创建新的RocksDB存储实例
func NewRocksDBStore(config StoreConfig) (Store, error) {
	// 创建默认选项
	opts := grocksdb.NewDefaultOptions()
	rOpts := grocksdb.NewDefaultReadOptions()
	wOpts := grocksdb.NewDefaultWriteOptions()
	cfOpts := grocksdb.NewDefaultColumnFamilyOptions()

	// 设置选项
	opts.SetCreateIfMissing(true)
	opts.SetCreateMissingColumnFamilies(true)

	// 打开RocksDB数据库
	db, cfHandles, err := grocksdb.OpenDBColumnFamilies(
		config.Path,
		opts,
		[]string{"default"},
		[]*grocksdb.ColumnFamilyOptions{cfOpts},
	)

	if err != nil {
		return nil, err
	}

	return &RocksDBStore{
		db:         db,
		snap:       nil,
		opts:       opts,
		rOpts:      rOpts,
		wOpts:      wOpts,
		cfOpts:     cfOpts,
		cfHandles:  cfHandles,
		isSnapshot: false,
	}, nil
}

// Get 获取指定key的值
func (s *RocksDBStore) Get(key []byte) ([]byte, error) {
	if s.db == nil {
		return nil, ErrStoreClosed
	}

	value, err := s.db.Get(s.rOpts, key)
	if err != nil {
		return nil, err
	}
	defer value.Free()

	if value.Size() == 0 {
		return nil, ErrNotFound
	}

	result := make([]byte, value.Size())
	copy(result, value.Data())
	return result, nil
}

// Put 设置key-value对
func (s *RocksDBStore) Put(key []byte, value []byte) error {
	if s.db == nil {
		return ErrStoreClosed
	}

	if s.isSnapshot {
		return NewError("snapshot does not support write operations")
	}

	return s.db.Put(s.wOpts, key, value)
}

// Delete 删除指定key
func (s *RocksDBStore) Delete(key []byte) error {
	if s.db == nil {
		return ErrStoreClosed
	}

	if s.isSnapshot {
		return NewError("snapshot does not support write operations")
	}

	return s.db.Delete(s.wOpts, key)
}

// Batch 创建批量操作对象
func (s *RocksDBStore) Batch() Batch {
	if s.db == nil || s.isSnapshot {
		return nil
	}

	return &RocksDBBatch{
		batch: grocksdb.NewWriteBatch(),
		db:    s.db,
		wOpts: s.wOpts,
	}
}

// Iterator 创建迭代器
func (s *RocksDBStore) Iterator(para ...[]byte) Iterator {
	if s.db == nil {
		return nil
	}

	iter := s.db.NewIterator(s.rOpts)
	if len(para) > 0 {
		iter.Seek(para[0])
	}

	return &RocksDBIterator{
		iter: iter,
	}
}

// Snapshot 创建快照
func (s *RocksDBStore) Snapshot() (Snapshot, error) {
	if s.db == nil {
		return nil, ErrStoreClosed
	}

	if s.isSnapshot {
		return nil, NewError("cannot create snapshot from snapshot")
	}

	// 创建快照
	snapshot := s.db.NewSnapshot()

	// 创建快照专用的读取选项
	snapROpts := grocksdb.NewDefaultReadOptions()
	snapROpts.SetSnapshot(snapshot)

	return &RocksDBSnapshot{
		store: &RocksDBStore{
			db:         s.db,
			snap:       snapshot,
			opts:       s.opts,
			rOpts:      snapROpts,
			wOpts:      s.wOpts,
			cfOpts:     s.cfOpts,
			cfHandles:  s.cfHandles,
			isSnapshot: true,
		},
		snapshot: snapshot,
	}, nil
}

// Close 关闭存储
func (s *RocksDBStore) Close() error {
	if s.db == nil {
		return nil
	}

	if !s.isSnapshot {
		// 关闭数据库
		for _, handle := range s.cfHandles {
			handle.Destroy()
		}
		s.db.Close()

		// 释放选项资源
		s.opts.Destroy()
		s.rOpts.Destroy()
		s.wOpts.Destroy()
		s.cfOpts.Destroy()

		s.db = nil
	}

	return nil
}

// Release 释放快照资源
func (s *RocksDBStore) Release() error {
	if s.isSnapshot {
		if s.snap != nil {
			s.snap.Release()
			s.snap = nil
		}
	}
	return nil
}

// Get 获取指定key的值（快照）
func (s *RocksDBSnapshot) Get(key []byte) ([]byte, error) {
	return s.store.Get(key)
}

// Iterator 从快照中创建迭代器
func (s *RocksDBSnapshot) Iterator(para ...[]byte) Iterator {
	return s.store.Iterator(para...)
}

// Release 释放快照资源
func (s *RocksDBSnapshot) Release() error {
	if s.snapshot != nil {
		s.snapshot.Release()
		s.snapshot = nil
	}
	return nil
}

// First 移动到第一个元素
func (i *RocksDBIterator) First() bool {
	if i.iter == nil {
		return false
	}
	i.iter.SeekToFirst()
	return i.iter.Valid()
}

// Last 移动到最后一个元素
func (i *RocksDBIterator) Last() bool {
	if i.iter == nil {
		return false
	}
	i.iter.SeekToLast()
	return i.iter.Valid()
}

// Seek 移动到大于等于指定key的位置
func (i *RocksDBIterator) Seek(key []byte) bool {
	if i.iter == nil {
		return false
	}
	i.iter.Seek(key)
	return i.iter.Valid()
}

// Next 移动到下一个元素
func (i *RocksDBIterator) Next() bool {
	if i.iter == nil || !i.iter.Valid() {
		return false
	}
	i.iter.Next()
	return i.iter.Valid()
}

// Prev 移动到前一个元素
func (i *RocksDBIterator) Prev() bool {
	if i.iter == nil || !i.iter.Valid() {
		return false
	}
	i.iter.Prev()
	return i.iter.Valid()
}

// Key 获取当前元素的key
func (i *RocksDBIterator) Key() []byte {
	if i.iter == nil || !i.iter.Valid() {
		return nil
	}
	key := i.iter.Key()
	result := make([]byte, key.Size())
	copy(result, key.Data())
	return result
}

// Value 获取当前元素的value
func (i *RocksDBIterator) Value() []byte {
	if i.iter == nil || !i.iter.Valid() {
		return nil
	}
	value := i.iter.Value()
	result := make([]byte, value.Size())
	copy(result, value.Data())
	return result
}

// Valid 检查迭代器是否有效
func (i *RocksDBIterator) Valid() bool {
	if i.iter == nil {
		return false
	}
	return i.iter.Valid()
}

// Release 释放迭代器资源
func (i *RocksDBIterator) Release() {
	if i.iter != nil {
		i.iter.Close()
		i.iter = nil
	}
}

// Put 添加put操作
func (b *RocksDBBatch) Put(key []byte, value []byte) {
	if b.batch != nil {
		b.batch.Put(key, value)
	}
}

// Delete 添加delete操作
func (b *RocksDBBatch) Delete(key []byte) {
	if b.batch != nil {
		b.batch.Delete(key)
	}
}

// Commit 提交批量操作
func (b *RocksDBBatch) Commit() error {
	if b.db == nil {
		return ErrStoreClosed
	}
	if b.batch == nil {
		return nil
	}

	err := b.db.Write(b.wOpts, b.batch)
	b.batch.Destroy()
	return err
}
