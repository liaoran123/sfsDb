package indexCache

import (
	"fmt"
	"sync"
	"testing"

	"github.com/liaoran123/sfsDb/storage"
)

// 测试多个迭代器配合使用的情况
func TestIteratorCacheMultiple(t *testing.T) {
	// 创建迭代器缓存，容量为 10
	cache := NewIteratorCache(10)

	// 创建多个模拟迭代器
	iter1 := &mockIterator{}
	iter2 := &mockIterator{}
	iter3 := &mockIterator{}

	// 测试设置多个迭代器
	key := []byte("multiple_iterators")
	cache.SetMultiple(key, []storage.Iterator{iter1, iter2, iter3})

	// 测试获取多个迭代器
	iters, ok := cache.GetMultiple(key)
	if !ok {
		t.Error("Expected to find multiple iterators")
	}

	if len(iters) != 3 {
		t.Errorf("Expected 3 iterators, got %d", len(iters))
	}

	// 测试获取单个迭代器（向后兼容）
	iter, ok := cache.Get(key)
	if !ok {
		t.Error("Expected to find iterator (backward compatibility)")
	}

	if iter != iters[0] {
		t.Error("Expected first iterator (backward compatibility)")
	}

	// 测试删除多个迭代器
	cache.Delete(key)

	// 测试删除后无法获取
	iters, ok = cache.GetMultiple(key)
	if ok {
		t.Error("Expected not to find multiple iterators after delete")
	}

	// 测试删除后无法获取单个迭代器（向后兼容）
	iter, ok = cache.Get(key)
	if ok {
		t.Error("Expected not to find iterator after delete (backward compatibility)")
	}

	// 测试资源释放
	if !iter1.released || !iter2.released || !iter3.released {
		t.Error("Expected all iterators to be released")
	}
}

// 测试多个迭代器的并发使用
func TestIteratorCacheMultipleConcurrent(t *testing.T) {
	// 创建迭代器缓存，容量为 20
	cache := NewIteratorCache(20)

	// 并发设置和获取多个迭代器
	var wg sync.WaitGroup
	concurrency := 10

	wg.Add(concurrency)
	for i := 0; i < concurrency; i++ {
		go func(goroutineID int) {
			defer wg.Done()
			key := []byte(fmt.Sprintf("multiple-key-%d", goroutineID))

			// 创建多个迭代器
			iters := make([]storage.Iterator, 3)
			for j := 0; j < 3; j++ {
				iters[j] = &mockIterator{}
			}

			// 设置多个迭代器
			cache.SetMultiple(key, iters)

			// 获取多个迭代器
			retrievedIters, ok := cache.GetMultiple(key)
			if !ok || len(retrievedIters) != 3 {
				t.Errorf("Expected to find 3 iterators for key %s", key)
			}

			// 获取单个迭代器（向后兼容）
			_, ok = cache.Get(key)
			if !ok {
				t.Errorf("Expected to find iterator for key %s (backward compatibility)", key)
			}
		}(i)
	}

	wg.Wait()

	// 测试清空缓存
	cache.Clear()

	// 测试清空后无法获取
	key := []byte("multiple-key-0")
	_, ok := cache.GetMultiple(key)
	if ok {
		t.Error("Expected not to find multiple iterators after clear")
	}
}
