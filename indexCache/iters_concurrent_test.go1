package indexCache

import (
	"fmt"
	"sync"
	"testing"
	"time"
)

// 并发测试迭代器缓存
func TestIteratorCacheConcurrent(t *testing.T) {
	// 创建迭代器缓存，容量为 100
	cache := NewIteratorCache(100)

	// 测试并发添加和获取
	t.Run("ConcurrentAddAndGet", func(t *testing.T) {
		var wg sync.WaitGroup
		concurrency := 50
		operationsPerGoroutine := 10

		// 并发添加
		wg.Add(concurrency)
		for i := 0; i < concurrency; i++ {
			go func(goroutineID int) {
				defer wg.Done()
				for j := 0; j < operationsPerGoroutine; j++ {
					key := []byte(fmt.Sprintf("key-%d-%d", goroutineID, j))
					iter := &mockIterator{}
					cache.Set(key, iter)
					// 验证添加成功
					_, ok := cache.Get(key)
					if !ok {
						t.Errorf("Expected to find key: %s", key)
					}
				}
			}(i)
		}

		wg.Wait()
	})

	// 测试并发清空
	t.Run("ConcurrentClear", func(t *testing.T) {
		// 先添加一些数据
		for i := 0; i < 10; i++ {
			key := []byte(fmt.Sprintf("clear-key-%d", i))
			iter := &mockIterator{}
			cache.Set(key, iter)
		}

		var wg sync.WaitGroup
		concurrency := 10

		// 并发清空
		wg.Add(concurrency)
		for i := 0; i < concurrency; i++ {
			go func() {
				defer wg.Done()
				cache.Clear()
				// 验证清空后无法获取
				key := []byte("clear-key-0")
				_, ok := cache.Get(key)
				if ok {
					t.Error("Expected not to find key after clear")
				}
			}()
		}

		wg.Wait()
	})

	// 测试并发调整大小
	t.Run("ConcurrentResize", func(t *testing.T) {
		// 先添加一些数据
		for i := 0; i < 10; i++ {
			key := []byte(fmt.Sprintf("resize-key-%d", i))
			iter := &mockIterator{}
			cache.Set(key, iter)
		}

		var wg sync.WaitGroup
		concurrency := 10

		// 并发调整大小
		wg.Add(concurrency)
		for i := 0; i < concurrency; i++ {
			go func() {
				defer wg.Done()
				// 随机调整大小
				newCapacity := 50 + (i % 50)
				cache.Resize(newCapacity)
				// 调整后应该能添加新元素
				key := []byte(fmt.Sprintf("new-key-%d", time.Now().UnixNano()))
				iter := &mockIterator{}
				cache.Set(key, iter)
				_, ok := cache.Get(key)
				if !ok {
					t.Error("Expected to find new key after resize")
				}
			}()
		}

		wg.Wait()
	})

	// 测试并发删除
	t.Run("ConcurrentDelete", func(t *testing.T) {
		// 先添加一些数据
		for i := 0; i < 100; i++ {
			key := []byte(fmt.Sprintf("delete-key-%d", i))
			iter := &mockIterator{}
			cache.Set(key, iter)
		}

		var wg sync.WaitGroup
		concurrency := 10

		// 并发删除
		wg.Add(concurrency)
		for i := 0; i < concurrency; i++ {
			go func(goroutineID int) {
				defer wg.Done()
				for j := goroutineID * 10; j < (goroutineID+1)*10; j++ {
					key := []byte(fmt.Sprintf("delete-key-%d", j))
					cache.Delete(key)
					// 验证删除成功
					_, ok := cache.Get(key)
					if ok {
						t.Errorf("Expected not to find key after delete: %s", key)
					}
				}
			}(i)
		}

		wg.Wait()
	})

	// 测试并发混合操作
	t.Run("ConcurrentMixedOperations", func(t *testing.T) {
		var wg sync.WaitGroup
		concurrency := 50

		// 并发执行混合操作
		wg.Add(concurrency)
		for i := 0; i < concurrency; i++ {
			go func(goroutineID int) {
				defer wg.Done()
				for j := 0; j < 20; j++ {
					switch j % 4 {
					case 0:
						// 添加
						key := []byte(fmt.Sprintf("mixed-key-%d-%d", goroutineID, j))
						iter := &mockIterator{}
						cache.Set(key, iter)
					case 1:
						// 获取
						key := []byte(fmt.Sprintf("mixed-key-%d-%d", goroutineID, j-1))
						cache.Get(key)
					case 2:
						// 删除
						key := []byte(fmt.Sprintf("mixed-key-%d-%d", goroutineID, j-2))
						cache.Delete(key)
					case 3:
						// 调整大小（每10次操作执行一次）
						if j%10 == 0 {
							cache.Resize(50 + (goroutineID % 50))
						}
					}
				}
			}(i)
		}

		wg.Wait()
	})
}

// 测试迭代器资源释放
func TestIteratorCacheResourceRelease(t *testing.T) {
	// 创建迭代器缓存
	cache := NewIteratorCache(10)

	// 添加一些迭代器（不超出容量）
	iters := make([]*mockIterator, 10)
	for i := 0; i < 10; i++ {
		iters[i] = &mockIterator{}
		key := []byte(fmt.Sprintf("resource-key-%d", i))
		cache.Set(key, iters[i])
	}

	// 检查是否有未释放的迭代器
	for _, iter := range iters {
		if iter.released {
			t.Errorf("Expected iterator to be not released yet")
		}
	}

	// 清空缓存
	cache.Clear()

	// 检查所有迭代器是否都被释放
	for _, iter := range iters {
		if !iter.released {
			t.Errorf("Expected iterator to be released")
		}
	}
}
