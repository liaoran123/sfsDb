package indexCache

import (
	"testing"
)

// TestPrimaryKeyCache 测试主键缓存
func TestPrimaryKeyCache(t *testing.T) {
	// 创建主键缓存
	cache := NewPrimaryKeyCache(10)
	
	// 测试基本操作
	key1 := []byte("key1")
	value1 := []byte("value1")
	
	// 测试Set和Get
	cache.Set(key1, value1)
	value, ok := cache.Get(key1)
	if !ok || string(value) != string(value1) {
		t.Errorf("Expected value1, got %s", value)
	}
	
	// 测试不存在的键
	key2 := []byte("key2")
	value, ok = cache.Get(key2)
	if ok || value != nil {
		t.Errorf("Expected nil, got %s", value)
	}
	
	// 测试缓存大小限制
	for i := 0; i < 20; i++ {
		key := []byte("key" + string(rune('0'+i)))
		value := []byte("value" + string(rune('0'+i)))
		cache.Set(key, value)
	}
	
	// 测试最开始的键是否被淘汰
	value, ok = cache.Get(key1)
	if ok {
		t.Errorf("Expected key1 to be evicted, but it's still in cache")
	}
	
	// 测试动态调整缓存大小
	cache.Resize(5)
	
	// 测试调整后的缓存大小
	key3 := []byte("key3")
	value3 := []byte("value3")
	cache.Set(key3, value3)
	value, ok = cache.Get(key3)
	if !ok || string(value) != string(value3) {
		t.Errorf("Expected value3, got %s", value)
	}
}

// TestNormalIndexCache 测试普通索引缓存
func TestNormalIndexCache(t *testing.T) {
	// 创建普通索引缓存
	cache := NewNormalIndexCache(5)
	
	// 测试基本操作
	indexName := "test_index"
	indexKey := "test_key"
	primaryKey := []byte("primary_key")
	
	// 测试Set和Get
	cache.Set(indexName, indexKey, primaryKey)
	value, ok := cache.Get(indexName, indexKey)
	if !ok || string(value) != string(primaryKey) {
		t.Errorf("Expected primary_key, got %s", value)
	}
	
	// 测试不存在的键
	value, ok = cache.Get(indexName, "non_existent")
	if ok || value != nil {
		t.Errorf("Expected nil, got %s", value)
	}
	
	// 测试动态调整缓存大小
	cache.Resize(10)
	
	// 测试调整后的缓存
	indexKey2 := "test_key2"
	primaryKey2 := []byte("primary_key2")
	cache.Set(indexName, indexKey2, primaryKey2)
	value, ok = cache.Get(indexName, indexKey2)
	if !ok || string(value) != string(primaryKey2) {
		t.Errorf("Expected primary_key2, got %s", value)
	}
}

// TestFullTextIndexCache 测试全文索引缓存
func TestFullTextIndexCache(t *testing.T) {
	// 创建全文索引缓存
	cache := NewFullTextIndexCache(5, 5)
	
	// 测试分词缓存
	text := "test text"
	tokens := []string{"test", "text"}
	
	// 测试SetTokens和GetTokens
	cache.SetTokens(text, tokens)
	result, ok := cache.GetTokens(text)
	if !ok || len(result) != 2 {
		t.Errorf("Expected tokens [test, text], got %v", result)
	}
	
	// 测试搜索结果缓存
	query := "test query"
	resultValue := []byte("result value")
	
	// 测试SetResult和GetResult
	cache.SetResult(query, resultValue)
	value, ok := cache.GetResult(query)
	if !ok || string(value) != string(resultValue) {
		t.Errorf("Expected result value, got %s", value)
	}
	
	// 测试动态调整缓存大小
	cache.Resize(10, 10)
	
	// 测试调整后的缓存
	text2 := "test text 2"
	tokens2 := []string{"test", "text", "2"}
	cache.SetTokens(text2, tokens2)
	result, ok = cache.GetTokens(text2)
	if !ok || len(result) != 3 {
		t.Errorf("Expected tokens [test, text, 2], got %v", result)
	}
}

// TestIndexCacheManager 测试缓存管理器
func TestIndexCacheManager(t *testing.T) {
	// 创建默认缓存管理器
	manager := NewDefaultIndexCacheManager()
	
	// 测试获取缓存
	pkCache := manager.GetPrimaryKeyCache()
	if pkCache == nil {
		t.Errorf("Expected primary key cache, got nil")
	}
	
	normalCache := manager.GetNormalIndexCache()
	if normalCache == nil {
		t.Errorf("Expected normal index cache, got nil")
	}
	
	fullTextCache := manager.GetFullTextIndexCache()
	if fullTextCache == nil {
		t.Errorf("Expected full text index cache, got nil")
	}
	
	// 测试获取配置
	config := manager.GetConfig()
	if config.PkCacheCapacity != 10000 {
		t.Errorf("Expected PkCacheCapacity 10000, got %d", config.PkCacheCapacity)
	}
	
	// 测试动态调整缓存大小
	newConfig := DefaultCacheConfig()
	newConfig.PkCacheCapacity = 5000
	newConfig.NormalCacheCapacity = 2500
	newConfig.FullTextCacheCapacity = 1000
	newConfig.TokenCacheCapacity = 1500
	
	manager.Resize(newConfig)
	
	// 测试调整后的配置
	updatedConfig := manager.GetConfig()
	if updatedConfig.PkCacheCapacity != 5000 {
		t.Errorf("Expected PkCacheCapacity 5000, got %d", updatedConfig.PkCacheCapacity)
	}
}
